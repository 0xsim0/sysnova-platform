    "check-config": "result=$(grep -r 'https://sysnova-it\\.de' --include='*.ts' --include='*.tsx' app/ components/ lib/ | grep -v 'lib/config.ts' | grep -v 'app/blog/'); if [ -n \"$result\" ]; then printf 'ERROR: Hardcoded domain strings found outside lib/config.ts:\\n%s\\n' \"$result\" && exit 1; fi",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check-config:help": "# Excludes app/blog/ because blog prose legitimately contains the domain in href/JSON-LD"
  },
